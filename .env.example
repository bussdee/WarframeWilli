# Vorlage. Die echte .env entsteht auf dem Zielgeraet (pi/pi-start.sh legt sie an) und wird nie uebertragen.
# Es stehen keine Geheimnisse darin.

# LAN-Adresse des Geraets, an die der Port gebunden wird (nie 0.0.0.0)
BIND_ADDR=127.0.0.1
# Host-Port, auf dem Pi aus 8100 bis 8199
APP_PORT=8100
# Benutzer und Gruppe, denen ./data gehoert (auf dem Pi: id -u und id -g des Benutzers, dem das Projekt gehoert)
PUID=1000
PGID=1000
# Daten-Update automatisch alle N Tage (0 = aus, nur von Hand)
WFW_AUTO_UPDATE_TAGE=0
